# Local Supabase PostgreSQL connection. Use DB_URL or the POSTGRES_URL
# / POSTGRES_PRISMA_URL variables provided by the Vercel Supabase integration.
DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres
DB_SSLMODE=require
DB_SCHEMA=public

# Alternatively, provide the individual PostgreSQL connection values.
# Vercel's POSTGRES_HOST, POSTGRES_DATABASE, POSTGRES_USER, and POSTGRES_PASSWORD
# are also supported when no connection URL is available.
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=
# DB_PASSWORD=
