# Local Supabase PostgreSQL connection. Use DB_URL or the POSTGRES_URL
# / POSTGRES_PRISMA_URL variables provided by the Vercel Supabase integration.
DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres
DB_SSLMODE=require
DB_SCHEMA=public

# Supabase Auth (use the project's public anon/publishable key, never the service-role key).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Gemini content trend research (server-only secret; never add NEXT_PUBLIC_ to this).
GEMINI_API_KEY=

# Instagram Insights (server-only secrets; never add NEXT_PUBLIC_ to these).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://YOUR_DOMAIN/api/integrations/instagram/callback
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
# Optional; defaults to the current Meta Graph API version.
INSTAGRAM_API_VERSION=v27.0

# Optional: authenticated user email that may claim existing rows with user_id IS NULL.
APP_OWNER_EMAIL=owner@example.com

# Alternatively, provide the individual PostgreSQL connection values.
# Vercel's POSTGRES_HOST, POSTGRES_DATABASE, POSTGRES_USER, and POSTGRES_PASSWORD
# are also supported when no connection URL is available.
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=
# DB_PASSWORD=
